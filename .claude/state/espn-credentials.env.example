# ESPN Fantasy — private league access.
#
# Copy to `.claude/state/espn-credentials.env` (gitignored) and fill in.
# Never paste these values into Slack, a Haven note, a chat message, or a commit.
# They are live session cookies: anyone holding them can act as you on ESPN.
#
#   cp .claude/state/espn-credentials.env.example .claude/state/espn-credentials.env
#   set -a && . .claude/state/espn-credentials.env && set +a
#
# Where to find them (Chrome, logged in to fantasy.espn.com):
#   DevTools -> Application -> Storage -> Cookies -> https://fantasy.espn.com
#   copy the values of `espn_s2` and `SWID`.
#
# The league id is in your league URL:
#   https://fantasy.espn.com/football/league?leagueId=XXXXXXX

ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_S2=
ESPN_SWID=
